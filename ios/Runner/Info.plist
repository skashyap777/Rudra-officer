	<string>This app needs camera access to capture pothole and inspection photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs photo library access to select profile and report images.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>This app sends report status and assignment notifications.</string>
